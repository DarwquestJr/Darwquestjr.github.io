							if (lsInitialized) { clearInterval(lsPollTimer); return; }
							if (window.LSAFFEvents && typeof window.LSAFFEvents.init === 'function') {
								lsDoInit(window.LSAFFEvents);
								clearInterval(lsPollTimer);
								return;
							}
							lsPollCount++;
							if (lsPollCount > 50) { // ~5s at 100ms
								clearInterval(lsPollTimer);
							}
						}, 100);
					}

					if (window.LSAFFEvents && typeof window.LSAFFEvents.init === 'function') {
						lsDoInit(window.LSAFFEvents);
					} else {
