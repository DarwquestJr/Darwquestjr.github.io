<script type="text/javascript">

  window.PUR_COUNTRIES = "be,bg,dk,de,ee,fi,fr,gr,ie,it,hr,lt,lv,lu,mt,nl,at,pl,pt,ro,se,sk,si,es,cz,hu,cy,ch,is,no,li,br,gb";
  window.PUR_ENDPOINT = "https://plan.all3dp.com/ce/pur.js";

  (function(){

    var getUserCountry = function() {
      var name = 'country';
      var value = "; " + document.cookie;
      var parts = value.split("; " + name + "=");

      if (parts.length == 2) {
        return parts.pop().split(";").shift();
      } else {
        return 'us';       }
    }

    var getCookie = function(name) {
      var value = "; " + document.cookie;
      var parts = value.split("; " + name + "=");

      if (parts.length == 2) {
        return parts.pop().split(";").shift();
      } else {
        return '';
      }
    }

    var setCookie = function(name, value, days) {
      var expires = "";
      if (days) {
        var date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        expires = "; expires=" + date.toUTCString();
      }
      document.cookie = name + "=" + (value || "") + expires + "; path=/";
    }

    var country = getUserCountry();
    var purForceAds = true;

    
       var countries = [];
       if(window.PUR_COUNTRIES.length > 1) {
         countries = window.PUR_COUNTRIES.split(',');
       }

       if(countries.length > 0) {
         if(countries.includes(country)) {
          purForceAds = false;
         }
       }
    
    if((getCookie('PUR_SUBSCRIPTION') === null || getCookie('PUR_SUBSCRIPTION') === "") && purForceAds === true) {
      setCookie('PUR_SUBSCRIPTION', 'ADS', 30);
    }

    window.addEventListener('CMP_READY', (event) => {

      var script = document.createElement('script');
      script.setAttribute('async', true)
      script.setAttribute('type', "module")
      script.setAttribute('crossorigin', true)
      script.setAttribute('src', PUR_ENDPOINT)
      document.head.appendChild(script)

    }, { passive: true, once: true });

    document.addEventListener("readystatechange", (event) => {
      if (document.readyState === 'interactive') {
        var modal = document.createElement('pur-modal');
        modal.setAttribute('lang', "en");
        modal.setAttribute('country-code', getUserCountry());
        document.querySelector('body').appendChild(modal);
      }
    }, { passive: true });

    window.addEventListener('PUR_SHOW_CHOICE', (event) => {
      window.ALL3DP_DL = window.ALL3DP_DL || [];
      window.ALL3DP_DL.push({ event: 'user_plan_change', user_plan: 'plan-choice'});
    }, { passive: true });

    window.addEventListener('PUR_SHOW_ORDER', (event) => {
      window.ALL3DP_DL = window.ALL3DP_DL || [];
      window.ALL3DP_DL.push({ event: 'user_plan_change', user_plan: 'plan-pay'});
    }, { passive: true });

    window.addEventListener('PUR_SUBSCRIPTION_CHANGED', (event) => {
      window.ALL3DP_DL = window.ALL3DP_DL || [];

      if(event.detail === 'PREMIUM') {
        window.ALL3DP_DL.push({ event: 'user_plan_change', user_plan: 'pur'});
      }

      if(event.detail === 'ADS') {
        window.ALL3DP_DL.push({ event: 'user_plan_change', user_plan: 'free'});
      }

    }, { passive: true });

  })();

</script>
