    <script type="text/javascript">
      (function () {

        function loadCommentScript(element) {

          if(!element) { return; }

          const d = document;
          const COMMENTS_URL = "comments.all3dp.com";
          const s = d.createElement("script");

          s.src = "https://" + COMMENTS_URL + "/assets/js/embed.js";
          s.async = true;

          s.onload = function () {
            Coral.createStreamEmbed({
              id: element.getAttribute('id'),
              storyID: "article-212311",
              storyURL: "https://all3dp.com/2/3d-printing-tools-3d-printer-accessories/",
              autoRender: true,
              rootURL: "https://" + COMMENTS_URL,
            });
          };

          (d.head || d.body).appendChild(s);
        }

        function observeElement(element) {

          const vhMargin = 2;

          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                loadCommentScript(element);
                obs.disconnect();
              }
            });
          }, {
            rootMargin: `${vhMargin * window.innerHeight}px 0px ${vhMargin * window.innerHeight}px 0px`,
            threshold: 0.1
          });

          observer.observe(element);
        }

        window.addEventListener('all3dp:iubPreferenceExpressed', (p) => {

          if(p && p['preference']['purposes']['1'] === true) {

            const commentId = 'coral_thread';
            const commentElm = document.getElementById(commentId)

            if (commentElm) {
              observeElement(commentElm);
            } else {
              const mutationObserver = new MutationObserver((mutations, obs) => {
                const newTarget = document.getElementById(commentId);
                if (newTarget) {
                  observeElement(newTarget);
                  obs.disconnect();
                }
              });

              mutationObserver.observe(document.body, {
                childList: true,
                subtree: true
              });
            }
          }
        }, {once: true, passive: true});
      })();
    </script>
