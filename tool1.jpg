<script type="text/javascript">

  function __cmpRemoveParamAndReload(param) {
      const url = new URL(window.location.href);

      if (param && url.searchParams.has(param)) {
        url.searchParams.delete(param);
        window.location.href = url.toString();
      } else {
        window.location.reload();
      }
  }

  const __cmpGetCookie = function(name) {
    var value = "; " + document.cookie;
    var parts = value.split("; " + name + "=");

    if (parts.length == 2) {
      return parts.pop().split(";").shift();
    } else {
      return '';
    }
  }


    __cmp("addEventListener", ["settings",() => {
    console.log('CMP loaded');
    document.dispatchEvent(new CustomEvent('CMP_READY', { bubbles: true }))
  }, false], null);

    __cmp("addEventListener", ["loadShowing",() => {
    const url = new URL(window.location.href);
    const hasCMPScreenParam = url.searchParams.has('cmpscreen');

    if(!hasCMPScreenParam) {
      __cmp('close');
    }

  }, false ],null);


  window.addEventListener('PUR_SHOW_COMPLETE', (event) => {
    __cmp('setConsent', 0);
    __cmp('setConsent', 1);
    __cmp('setPurposeConsent', ['c52', false]);   }, { passive: true });

  window.addEventListener('PUR_SUBSCRIPTION_CHANGED', (event) => {

    if(event.detail === 'PREMIUM' || event.detail === 'ADS') {
      const consentState = __cmp('consentStatus');

      if(consentState.consentExists !== true || event.detail === 'ADS') {
        __cmp('setConsent', 1);
      }

      window.ALL3DP_IUB_PREFERENCES = {
        purposes: {
          ...{
            1: true,
            3: true,
            4: true,
            5: true
          }
        }
      }

      if(event.detail === 'PREMIUM') {
        window.ALL3DP_IUB_PREFERENCES.purposes['5'] = false;
      }

            
      window.ALL3DP_IUB_CALLBACK(window.ALL3DP_IUB_PREFERENCES);
    }

  }, { passive: true });


  const onConsentRejected = () => {
    console.log('consentrejected');
    if(__cmpGetCookie('PUR_SUBSCRIPTION') !== 'PREMIUM') {
      __cmp("removeEventListener",["consentrejected", onConsentRejected, false], null);
      __cmp("removeEventListener",["consentcustom", onConsentCustom, false], null);
      __cmp("setConsent", 0);
      document.dispatchEvent(new CustomEvent('PUR_INVALIDATE', { bubbles: true }))
      __cmpRemoveParamAndReload('cmpscreen');
    }
  }

  const onConsentCustom = (eventname, cmpobject, subtype) => {
    console.log('consentcustom');
    if(__cmpGetCookie('PUR_SUBSCRIPTION') !== 'PREMIUM') {
      __cmp("removeEventListener",["consentrejected", onConsentRejected, false], null);
      __cmp("removeEventListener",["consentcustom", onConsentCustom, false], null);
      __cmp("setConsent", 0);
      document.dispatchEvent(new CustomEvent('PUR_INVALIDATE', { bubbles: true }))
      __cmpRemoveParamAndReload('cmpscreen');
    }
  }

  __cmp("addEventListener",["consentrejected", onConsentRejected, false], null);

  __cmp("addEventListener",["consentapproved",() => {
    // console.log('consentapproved');
  }, false], null);

  __cmp("addEventListener",["consentcustom", onConsentCustom, false], null);


  document.addEventListener('DOMContentLoaded', function() {
    document.querySelector('body').addEventListener('click', function(event) {
      if (event.target.matches('.cmp-show-screen')) {
        event.preventDefault();
        event.stopPropagation();
        __cmp('showScreen');
